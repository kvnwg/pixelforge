{
  "name": "pixelforge-chibi",
  "version": 1,
  "notes": "Measured from style/anchor.png. Code must read colors and geometry from this file, never hardcode them. See docs/STYLE_GUIDE.md.",
  "canvas": {
    "w": 32,
    "h": 32
  },
  "pivot": {
    "x": 15,
    "y": 27
  },
  "baseline_y": 27,
  "safe_bounds": {
    "x0": 2,
    "y0": 2,
    "x1": 29,
    "y1": 30
  },
  "directions": [
    "s",
    "e",
    "n",
    "w"
  ],
  "mirror": {
    "w": {
      "from": "e",
      "axis_x": 15,
      "formula": "x_new = 2*axis_x - x"
    }
  },
  "outline": {
    "color": "#3a263a",
    "mode": "4-neighbor",
    "open_soles": {
      "enabled": true,
      "rows_from_bottom": 3,
      "rule": "a ring pixel is left open (not outlined) when it touches the silhouette only from above (no silhouette pixel to its left, right or below) and its row is at or below (lowest sprite row - 2). The ground shadow shows there instead."
    },
    "outline_colored_pixels_in_parts": "preserved as hand-placed details; they do not count as silhouette for ring generation"
  },
  "shadow": {
    "color": "#3a263a",
    "alpha": 70,
    "ellipse_rows": {
      "26": [
        11,
        19
      ],
      "27": [
        10,
        20
      ],
      "28": [
        10,
        20
      ],
      "29": [
        11,
        19
      ]
    },
    "note": "Drawn behind the character. On preview beige #c3bc9d it produces #9d9382, matching the original."
  },
  "preview_backgrounds": {
    "beige": "#c3bc9d",
    "light": "#e8e2d0",
    "dark": "#2b2b33"
  },
  "effects": {
    "flash": "#efe2c8",
    "flash_note": "Only allowed in frames flagged flash (hurt/death). Lighter than the palette rule on purpose.",
    "close_eyes": {
      "material": "skin",
      "shade": 0,
      "note": "Blink and hurt frames replace each eye pixel with this skin shade (recolored)."
    }
  },
  "constraints": {
    "oklch_L_range": [
      0.3,
      0.8
    ],
    "oklch_C_max": 0.09,
    "ramp_L_step_range": [
      0.05,
      0.1
    ],
    "ramp_hue_shift_deg_per_lighter_step": [
      3,
      10
    ],
    "max_colors_per_frame": 16,
    "alpha_values_allowed": [
      0,
      255
    ],
    "alpha_exception": "ground shadow pixels only: outline color at alpha 70",
    "limit_tolerance": 0.002,
    "ramp_L_step_slack": 0.005,
    "hue_shift_min_chroma": 0.02,
    "palette_check": "Errors (block a build): L or C outside the limits (with limit_tolerance, which absorbs 8-bit rounding of colors placed on a limit), pure black or white, shades not ordered dark to light, a color darker than the outline. Warnings (guidance for new presets): a lightness step outside ramp_L_step_range (with ramp_L_step_slack) or a hue shift outside ramp_hue_shift_deg_per_lighter_step, skipped for near-gray ramps (mean C under hue_shift_min_chroma). Warnings listed in accepted_ramp_warnings are known and accepted. See STYLE_GUIDE.md section 4.",
    "accepted_ramp_warnings": {
      "skin/light (anchor)": {
        "rules": [
          "hue_shift"
        ],
        "reason": "Anchor ground truth: the anchor's skin shifts hue only 1.5 to 2.6 degrees per step."
      },
      "skin/fair": {
        "rules": [
          "hue_shift"
        ],
        "reason": "Follows the anchor skin's small hue shift (about 2 degrees per step), so skin stays skin-colored in the light shade."
      },
      "skin/tan": {
        "rules": [
          "hue_shift"
        ],
        "reason": "Follows the anchor skin's small hue shift (about 2 degrees per step), so skin stays skin-colored in the light shade."
      },
      "cloth/navy (anchor)": {
        "rules": [
          "hue_shift"
        ],
        "reason": "Anchor ground truth: the navy dress turns 6 degrees cooler as it gets lighter."
      },
      "leather/brown (anchor)": {
        "rules": [
          "hue_shift"
        ],
        "reason": "Anchor ground truth: the dark leather shade #5e494c is redder than the two hair browns above it."
      },
      "bone/ivory": {
        "rules": [
          "hue_shift"
        ],
        "reason": "Shade 2 to 3 shifts 2.9 degrees, 0.1 under the guide; the ramp reads correctly in style/monster_fx_swatches.png."
      }
    }
  },
  "validator": {
    "singletons_max": 3,
    "flat_area_max": 22,
    "flat_share_max": 0.5,
    "change_budget": 0.35,
    "area_change_max": 0.15,
    "busy_singletons_share": 0.005,
    "busy_cluster_min_px": 3,
    "pivot_drift_px": {
      "s": 1,
      "n": 1,
      "e": 2,
      "w": 2
    },
    "motion_checked_anims": [
      "idle",
      "walk"
    ],
    "note": "Thresholds for QUALITY.md warnings. flat_area_max is the anchor's largest flat area (22 px of hair light); the doc's 12 would flag the anchor itself, and the anchor wins. W5 also needs that one shade to be more than flat_share_max of its material's visible pixels: a flat region is a material left unshaded, not a big cluster in a shaded one."
  },
